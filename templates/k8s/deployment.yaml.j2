apiVersion: apps/v1
kind: Deployment
metadata:
  name: << app.name >>
  labels:
    app.kubernetes.io/name: << app.name >>
    app.kubernetes.io/instance: << app.name >>-<< env >>
    app.kubernetes.io/component: service
    app.kubernetes.io/part-of: << app.name >>
    app.kubernetes.io/managed-by: jenkins
    environment: << env >>
spec:
  replicas: << replicas >>
  selector:
    matchLabels:
      app.kubernetes.io/name: << app.name >>
      app.kubernetes.io/instance: << app.name >>-<< env >>
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: << app.name >>
        app.kubernetes.io/instance: << app.name >>-<< env >>
        app.kubernetes.io/component: service
        app.kubernetes.io/part-of: << app.name >>
        app.kubernetes.io/managed-by: jenkins
        environment: << env >>
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: << app.name >>
          # Replaced by the release pipeline (sed) at deploy time
          image: << placeholder_image >>
          ports:
            - name: http
              containerPort: << port >>
          env:
            - name: APP_ENV
              value: << env >>
          readinessProbe:
            httpGet:
              path: << t.health_path >>
              port: http
            initialDelaySeconds: 10
          livenessProbe:
            httpGet:
              path: << t.health_path >>
              port: http
            initialDelaySeconds: 30
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
