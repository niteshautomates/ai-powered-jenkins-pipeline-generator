# Overrides for the << env >> environment
replicaCount: << replicas >>
environmentName: << env >>
env:
  APP_ENV: << env >>
<% if env == "prod" %>
autoscaling:
  enabled: true
  minReplicas: << replicas >>
  maxReplicas: 10
resources:
  requests:
    cpu: 250m
    memory: 256Mi
  limits:
    memory: 1Gi
<% endif %>
